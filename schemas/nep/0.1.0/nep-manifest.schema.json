        "action_lower_bounds": {
          "items": {
            "type": "number"
          },
          "title": "Action Lower Bounds",
          "type": "array"
        },
        "action_upper_bounds": {
          "items": {
            "type": "number"
          },
          "title": "Action Upper Bounds",
          "type": "array"
