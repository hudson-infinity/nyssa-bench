    "ArtifactContract": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "title": "Artifact Id",
          "type": "string"
        },
        "media_type": {
          "title": "Media Type",
          "type": "string"
        },
        "sha256": {
          "title": "Sha256",
          "type": "string"
        },
        "uri": {
          "title": "Uri",
          "type": "string"
        },
        "required": {
          "default": true,
          "title": "Required",
          "type": "boolean"
        }
      },
      "required": [
        "artifact_id",
        "media_type",
        "sha256",
        "uri"
      ],
      "title": "ArtifactContract",
      "type": "object"
    },
    "AssetContract": {
      "additionalProperties": false,
      "properties": {
        "asset_id": {
          "title": "Asset Id",
          "type": "string"
        },
        "asset_version": {
          "title": "Asset Version",
          "type": "string"
        },
        "sha256": {
          "title": "Sha256",
          "type": "string"
        },
        "license_id": {
          "title": "License Id",
          "type": "string"
        },
        "split": {
          "enum": [
            "train",
            "validation",
            "public_test",
            "hidden_test"
          ],
          "title": "Split",
          "type": "string"
        }
      },
      "required": [
        "asset_id",
        "asset_version",
        "sha256",
        "license_id",
        "split"
      ],
      "title": "AssetContract",
      "type": "object"
    },
    "ClaimContract": {
      "additionalProperties": false,
      "properties": {
        "format": {
          "const": "nyssa-nep-claim-contract-v0.1",
          "default": "nyssa-nep-claim-contract-v0.1",
          "title": "Format",
          "type": "string"
        },
        "contract_version": {
          "default": "0.1.0",
          "title": "Contract Version",
          "type": "string"
        },
        "requested_tier": {
          "enum": [
            "pipeline",
            "clean_simulation",
            "ood_robustness",
            "recovery_effectiveness",
            "cross_simulator",
            "sim_real_predictive"
          ],
          "title": "Requested Tier",
          "type": "string"
        },
        "evidence_artifact_ids": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Artifact Ids",
          "type": "array"
        },
        "run_validity_artifact_id": {
          "title": "Run Validity Artifact Id",
          "type": "string"
        },
        "benchmark_validity_artifact_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Benchmark Validity Artifact Id"
        },
        "real_evidence_artifact_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Real Evidence Artifact Id"
        }
      },
      "required": [
        "requested_tier",
        "evidence_artifact_ids",
        "run_validity_artifact_id"
      ],
      "title": "ClaimContract",
      "type": "object"
    },
    "FailureEvidenceContract": {
      "additionalProperties": false,
      "properties": {
        "format": {
          "const": "nyssa-nep-failure-evidence-contract-v0.1",
          "default": "nyssa-nep-failure-evidence-contract-v0.1",
          "title": "Format",
          "type": "string"
        },
        "contract_version": {
          "default": "0.1.0",
          "title": "Contract Version",
          "type": "string"
        },
        "event_format": {
          "const": "nyssa-failure-event-v1",
          "default": "nyssa-failure-event-v1",
          "title": "Event Format",
          "type": "string"
        },
        "ledger_artifact_id": {
          "title": "Ledger Artifact Id",
          "type": "string"
        },
        "detector_contract_artifact_id": {
          "title": "Detector Contract Artifact Id",
          "type": "string"
        },
        "temporal_precision": {
          "items": {
            "enum": [
              "exact_step",
              "step_interval",
              "terminal_only",
              "unknown"
            ],
            "type": "string"
          },
          "title": "Temporal Precision",
          "type": "array"
        },
        "evidence_visibility": {
          "items": {
            "enum": [
              "policy_observable",
              "privileged",
              "external"
            ],
            "type": "string"
          },
          "title": "Evidence Visibility",
          "type": "array"
        },
        "causal_semantics": {
          "enum": [
            "hypothesis_only",
            "intervention_supported"
          ],
          "title": "Causal Semantics",
          "type": "string"
