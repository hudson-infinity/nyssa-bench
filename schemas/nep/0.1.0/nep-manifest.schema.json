        "policy_id",
        "policy_version",
        "policy_family",
        "checkpoint_id",
        "checkpoint_sha256",
        "preprocessing_sha256",
        "observation_modalities",
        "action_representation",
        "action_dimension",
        "action_lower_bounds",
        "action_upper_bounds",
        "prediction_horizon",
        "execution_horizon",
        "state_semantics",
        "deterministic_seeding"
