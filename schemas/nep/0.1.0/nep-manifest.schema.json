        "stressor_id",
        "stressor_version",
        "category",
        "severity",
        "seed",
        "application_points",
        "parameters",
        "observable_by_policy",
        "privileged",
        "backend_confirmed"
      ],
      "title": "StressorEntryContract",
      "type": "object"
