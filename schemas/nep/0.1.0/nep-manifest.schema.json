    "StressorContract": {
      "additionalProperties": false,
      "properties": {
        "format": {
          "const": "nyssa-nep-stressor-contract-v0.1",
          "default": "nyssa-nep-stressor-contract-v0.1",
          "title": "Format",
          "type": "string"
        },
        "contract_version": {
          "default": "0.1.0",
