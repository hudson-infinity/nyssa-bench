    "StressorEntryContract": {
      "additionalProperties": false,
      "properties": {
        "stressor_id": {
          "title": "Stressor Id",
          "type": "string"
        },
        "stressor_version": {
          "title": "Stressor Version",
          "type": "string"
        },
        "category": {
          "enum": [
            "visual",
            "dynamics",
            "sensor",
            "system",
            "action",
            "language"
          ],
          "title": "Category",
          "type": "string"
        },
        "severity": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Severity",
          "type": "number"
        },
        "seed": {
          "minimum": 0,
          "title": "Seed",
          "type": "integer"
        },
        "application_points": {
          "items": {
            "type": "string"
          },
          "title": "Application Points",
          "type": "array"
