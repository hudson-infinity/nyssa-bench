    "PolicyContract": {
      "additionalProperties": false,
      "properties": {
        "format": {
          "const": "nyssa-nep-policy-contract-v0.1",
          "default": "nyssa-nep-policy-contract-v0.1",
          "title": "Format",
          "type": "string"
        },
        "contract_version": {
          "default": "0.1.0",
          "title": "Contract Version",
          "type": "string"
        },
        "policy_id": {
          "title": "Policy Id",
          "type": "string"
        },
        "policy_version": {
          "title": "Policy Version",
          "type": "string"
        },
        "policy_family": {
          "title": "Policy Family",
          "type": "string"
        },
        "checkpoint_id": {
          "title": "Checkpoint Id",
          "type": "string"
        },
        "checkpoint_sha256": {
          "title": "Checkpoint Sha256",
          "type": "string"
        },
        "preprocessing_sha256": {
          "title": "Preprocessing Sha256",
          "type": "string"
        },
        "observation_modalities": {
          "items": {
            "type": "string"
          },
          "title": "Observation Modalities",
          "type": "array"
