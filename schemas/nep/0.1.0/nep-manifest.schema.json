        "observable_by_policy": {
          "title": "Observable By Policy",
          "type": "boolean"
        },
        "privileged": {
          "title": "Privileged",
          "type": "boolean"
        },
        "backend_confirmed": {
          "title": "Backend Confirmed",
          "type": "boolean"
        },
        "backend_evidence_artifact_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
