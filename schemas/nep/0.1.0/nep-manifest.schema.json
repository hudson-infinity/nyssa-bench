  "additionalProperties": false,
  "properties": {
    "format": {
      "const": "nyssa-evaluation-protocol-v0.1",
      "default": "nyssa-evaluation-protocol-v0.1",
      "title": "Format",
      "type": "string"
    },
    "nep_version": {
      "default": "0.1.0",
      "title": "Nep Version",
      "type": "string"
    },
    "evaluation_id": {
      "title": "Evaluation Id",
      "type": "string"
    },
    "task": {
      "$ref": "#/$defs/TaskContract"
    },
    "stressor": {
      "$ref": "#/$defs/StressorContract"
    },
    "policy": {
      "$ref": "#/$defs/PolicyContract"
    },
    "failure_evidence": {
      "$ref": "#/$defs/FailureEvidenceContract"
    },
    "intervention": {
      "$ref": "#/$defs/InterventionContract"
