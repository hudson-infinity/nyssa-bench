FROM nvidia/cuda:12.4.1-runtime-ubuntu22.04

ARG TORCH_VERSION=2.5.1
ARG MANISKILL_VERSION=3.0.1

RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
       ca-certificates ffmpeg libegl1 libgl1 libglib2.0-0 libvulkan1 \
       mesa-vulkan-drivers python3 python3-pip \
    && rm -rf /var/lib/apt/lists/* \
    && python3 -m pip install --no-cache-dir \
       "torch==${TORCH_VERSION}" --index-url https://download.pytorch.org/whl/cu124 \
    && python3 -m pip install --no-cache-dir \
       "mani-skill==${MANISKILL_VERSION}" \
       "numpy>=1.26,<2.0" \
       "pydantic>=2.6" \
       "pyyaml>=6.0" \
       "gymnasium>=0.29" \
       "imageio>=2.34" \
       "imageio-ffmpeg>=0.5" \
       "packaging>=23.0" \
    && useradd --create-home --uid 10001 nyssa \
    && install -d -o nyssa -g nyssa /workspace

ARG NYSSA_VERSION
ARG NYSSA_COMMIT
ARG NYSSA_BUILD_DATE
ARG TARGETPLATFORM

LABEL org.opencontainers.image.title="NyssaBench ManiSkill" \
      org.opencontainers.image.description="CUDA and Vulkan ManiSkill evaluation runtime for NyssaBench" \
      org.opencontainers.image.source="https://github.com/hudson-infinity/nyssa-bench" \
      org.opencontainers.image.version="${NYSSA_VERSION}" \
      org.opencontainers.image.revision="${NYSSA_COMMIT}" \
      org.opencontainers.image.created="${NYSSA_BUILD_DATE}" \
      org.opencontainers.image.licenses="Apache-2.0" \
      io.hudson-labs.nyssa.python="3.10" \
      io.hudson-labs.nyssa.maniskill="${MANISKILL_VERSION}" \
      io.hudson-labs.nyssa.torch="${TORCH_VERSION}" \
      io.hudson-labs.nyssa.cuda="12.4" \
      io.hudson-labs.nyssa.vulkan="1.3"

ENV NYSSA_CONTAINER_PROFILE=maniskill \
    NYSSA_CONTAINER_VERSION=${NYSSA_VERSION} \
    NYSSA_CONTAINER_COMMIT=${NYSSA_COMMIT} \
    NYSSA_CONTAINER_BUILD_DATE=${NYSSA_BUILD_DATE} \
    NYSSA_CONTAINER_PLATFORM=${TARGETPLATFORM} \
    NYSSA_CONTAINER_PYTHON=3.10 \
    NYSSA_CONTAINER_MANISKILL=${MANISKILL_VERSION} \
    NYSSA_CONTAINER_TORCH=${TORCH_VERSION} \
    NYSSA_CONTAINER_CUDA=12.4 \
    NYSSA_CONTAINER_VULKAN=1.3 \
    MUJOCO_GL=egl \
    PYOPENGL_PLATFORM=egl \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

COPY dist/*.whl /tmp/nyssa-dist/
RUN wheel="$(find /tmp/nyssa-dist -maxdepth 1 -name '*.whl' -print -quit)" \
    && test -n "${wheel}" \
    && python3 -m pip install --no-cache-dir --no-deps "${wheel}" \
    && python3 -m pip check \
    && rm -rf /tmp/nyssa-dist

USER nyssa
WORKDIR /workspace

CMD ["python3", "-m", "nyssa_bench.container_smoke", "--profile", "maniskill", "--metadata-only", "--out", "/tmp/nyssa-smoke"]
